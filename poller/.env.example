# Copy to  .env  in the same folder and fill in real values.
#
# THIS FILE IS THE ONLY PLACE SECRETS LIVE. It stays on the poller box.
# VendoMonitor is a PUBLIC repo -- never commit a filled-in .env.
# .gitignore already excludes .env; do not override that.
#
# Every name below is exactly what mikrotik_status_poller.py reads. A name the
# code does not read is silently ignored, so do not invent new ones here.

# ---- Supabase ----
# Use the SERVICE key. Both boxes were found running on the public anon key,
# which is why anon still needs write access to mikrotik_status,
# vendo_devices, hotspot_vouchers and system_heartbeat. Switch both boxes,
# then those grants can be revoked. Rotate from the Supabase dashboard.
SUPABASE_URL=https://cviraqfhphhsonjmrtvu.supabase.co
SUPABASE_KEY=

# ---- This server (REQUIRED, no defaults -- see the v18 notes in the poller) ----
# Must match vendos.server_name / the monitor page SERVER.name byte-for-byte.
SERVER_NAME=Dicayas Server
MIKROTIK_HOST=
MIKROTIK_USER=
MIKROTIK_PASS=
# MIKROTIK_PORT=8728
# MIKROTIK_PLAINTEXT_LOGIN=true

# ---- Behaviour (optional; defaults shown) ----
# POLL_SECONDS=30                    every row is checked each cycle, PPP included
# FULL_REFRESH_EVERY_N_CYCLES=60     rewrite every row even if unchanged (30 min)
# NOISE_BYTES=1000                   traffic at or below this, with no lease, is not "online"
# SNAPSHOT_GAP_SEC=3
# VOUCHER_PROFILE=freewifi
# VOUCHER_EVERY_N_CYCLES=6
# SERVICE_NAME=                      defaults to mikrotik_status_poller_<server>

# ---- Self-update (v20) ----
# Only set true AFTER the scheduled task is configured to start again on its
# own: trigger repeats every 5 minutes indefinitely, and "If the task is
# already running" = "Do not start a new instance". The poller exits to
# update; without that task setting it would stay down.
# SELF_UPDATE=false                 (selfupdate=true also works: no Shift key needed)
# SELF_UPDATE_EVERY_N_CYCLES=20     about every 10 minutes at 30s cycles
#
# Not implemented (listed here before; the code never read them):
#   PPP_POLL_INTERVAL_SECONDS, PRUNE_MISSING_SECRETS, PRUNE_DRY_RUN
