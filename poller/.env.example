# Copy to  .env  in the same folder and fill in real values.
#
# THIS FILE IS THE ONLY PLACE SECRETS LIVE. It stays on the poller box.
# VendoMonitor is a PUBLIC repo -- never commit a filled-in .env.
# .gitignore already excludes .env; do not override that.

# ---- Supabase ----
# service key: needed because the poller writes mikrotik_status, which anon
# cannot write. Rotate this from the Supabase dashboard, not from git history.
SUPABASE_URL=https://cviraqfhphhsonjmrtvu.supabase.co
SUPABASE_SERVICE_KEY=

# ---- MikroTik (Dicayas) ----
MIKROTIK_HOST=192.168.40.1
MIKROTIK_USER=
MIKROTIK_PASS=

# ---- Behaviour ----
# vendo rows currently refresh every 90s. PPP rows refresh roughly daily, which
# is why outage durations are coarse -- lower this once the poller is pruning.
POLL_INTERVAL_SECONDS=90
PPP_POLL_INTERVAL_SECONDS=90

# Delete mikrotik_status rows whose PPP secret no longer exists on the router.
# Off by default so the first run after wiring this up cannot delete anything
# unexpectedly. Turn on once you have seen the dry-run counts in the log.
PRUNE_MISSING_SECRETS=false
PRUNE_DRY_RUN=true
